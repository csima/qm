{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-host",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "agents.calebsima.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "containers": [
    {
      "name": "agent-host-instances",
      "class_name": "Instance",
      "scheduling_policy": "durable_object",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "INSTANCE", "class_name": "Instance" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Instance"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-host",
      "database_id": "5c377e70-9bc8-4cbc-a67b-b14264a4821c",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "agent-host-state" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "r0xxx.cloudflareaccess.com",
    "ACCESS_AUD": "2223f687550cb6c4fd3a12d401b22511fd3a3f8ded450d52c83ff2f24f6b5da9",
    "ADMIN_EMAILS": "caleb@sima.cx",
    "PUBLIC_URL": "https://agents.calebsima.com",
    "BUILD_REPO": "csima/qm",
    "BUILD_WORKFLOW": "agent-build.yml",
    "BUILD_WORKFLOW_REF": "main",
  },
}
