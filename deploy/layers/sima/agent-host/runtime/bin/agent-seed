#!/bin/bash
set -euo pipefail
set -a
. /run/agent/env
set +a
mkdir -p "$HOME/.claude"
ensure_object() {
  if ! jq -e 'type == "object"' "$1" >/dev/null 2>&1; then
    if [ -e "$1" ]; then mv "$1" "$1.invalid-$(date +%s)"; fi
    echo '{}' >"$1"
  fi
}
version=$(claude --version | awk '{print $1}')
key_tail=""
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then key_tail=${ANTHROPIC_API_KEY: -20}; fi
config="$HOME/.claude.json"
ensure_object "$config"
jq --arg v "$version" --arg t "$key_tail" '
  .hasCompletedOnboarding = true
  | .lastOnboardingVersion = $v
  | .projects["/agent"].hasTrustDialogAccepted = true
  | .projects["/agent"].hasCompletedProjectOnboarding = true
  | if $t == "" then . else
      .customApiKeyResponses.approved = (((.customApiKeyResponses.approved // []) + [$t]) | unique)
      | .customApiKeyResponses.rejected = (.customApiKeyResponses.rejected // [])
    end' "$config" >"$config.tmp"
mv "$config.tmp" "$config"
settings="$HOME/.claude/settings.json"
ensure_object "$settings"
jq -s '
  (.[0] * .[1])
  | if (.hooks | type) == "object" then
      .hooks |= (map_values(
          if type == "array" then
            map(select(
              [(if type == "object" then .hooks else null end) | if type == "array" then .[] else empty end
                | (if type == "object" then .command else null end) // "" | tostring]
              | any(startswith("/usr/local/bin/agent-hook")) | not))
          else . end)
        | with_entries(select((.value | type) != "array" or (.value | length > 0))))
    else . end
  | if .hooks == {} then del(.hooks) else . end' "$settings" /opt/agent-host/claude-settings.json >"$settings.tmp"
mv "$settings.tmp" "$settings"
