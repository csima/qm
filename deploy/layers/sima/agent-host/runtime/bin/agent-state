#!/bin/bash
set -euo pipefail
marker=/var/lib/agent/last-snapshot
mkdir -p /var/lib/agent
case "$1" in
  changed)
    if [ ! -f "$marker" ] || [ -n "$(find /home/agent -newer "$marker" -print -quit)" ]; then echo yes; else echo no; fi
    ;;
  save)
    touch "$marker.next"
    tar -cz -C /home/agent --exclude=./.cache --exclude=./.npm .
    mv "$marker.next" "$marker"
    ;;
  restore)
    tar -xz -C /home/agent
    chown -R agent:agent /home/agent
    touch "$marker"
    ;;
  *)
    echo "usage: agent-state changed|save|restore" >&2
    exit 2
    ;;
esac
