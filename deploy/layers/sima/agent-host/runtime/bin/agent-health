#!/bin/bash
set -uo pipefail
boot=$(cat /run/agent/boot-id 2>/dev/null || true)
exec 9>/run/agent-health.lock
flock -w 10 9
agentd=up
if ! pgrep -u agent -f /opt/agent-host/agentd.mjs >/dev/null; then
  agentd=down
  if [ "${1:-}" = --repair ] && [ -n "$boot" ]; then
    runuser -u agent -- env HOME=/home/agent XDG_RUNTIME_DIR=/run/agent/xdg setsid node /opt/agent-host/agentd.mjs >>/var/log/agent/agentd.log 2>&1 </dev/null &
    agentd=restarted
  fi
fi
tmux_state=up
runuser -u agent -- env HOME=/home/agent tmux has-session -t =agent 2>/dev/null || tmux_state=down
printf 'boot=%s agentd=%s tmux=%s\n' "$boot" "$agentd" "$tmux_state"
