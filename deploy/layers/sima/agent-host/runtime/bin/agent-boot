#!/bin/bash
set -euo pipefail
cfg=$(cat)
install -d -o agent -g agent -m 700 /run/agent /run/agent/xdg
install -d -o agent -g agent -m 755 /var/lib/agent /var/lib/agent/queue /var/lib/agent/events /var/lib/agent/outbox /var/log/agent
install -d -o agent -g agent -m 755 /home/agent/work /home/agent/.agent-host /home/agent/.agent-host/sessions
install -d -o agent -g agent -m 755 /var/lib/agent/current
egress=$(jq -r '.egress // false' <<<"$cfg")
if [ "$egress" = true ]; then
  ca=/etc/cloudflare/certs/cloudflare-containers-ca.crt
  for _ in $(seq 1 50); do [ -s "$ca" ] && break; sleep 0.2; done
  [ -s "$ca" ] || { echo "the egress CA certificate did not appear at $ca" >&2; exit 1; }
  install -D -m 644 "$ca" /usr/local/share/ca-certificates/cloudflare-containers-ca.crt
  update-ca-certificates >/dev/null 2>&1
fi
umask 077
{
  jq -r '.env | to_entries[] | "export \(.key)=\(.value | @sh)"' <<<"$cfg"
  jq -r '"export AGENT_INSTANCE=\(.instance | @sh) AGENT_HARNESS=\(.harness | @sh) AGENT_BOOT_ID=\(.bootId | @sh)"' <<<"$cfg"
  if [ "$egress" = true ]; then
    echo "export NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/cloudflare-containers-ca.crt SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
  fi
} >/run/agent/env
jq -r '.appendSystemPrompt // ""' <<<"$cfg" >/run/agent/system-prompt.txt
jq -r '.sessions[]' <<<"$cfg" >/run/agent/sessions
jq -r '.bootId' <<<"$cfg" >/run/agent/boot-id
chown agent:agent /run/agent/env /run/agent/system-prompt.txt /run/agent/sessions
chmod 644 /run/agent/boot-id
umask 022
as_agent() { runuser -u agent -- env HOME=/home/agent XDG_RUNTIME_DIR=/run/agent/xdg "$@"; }
as_agent /usr/local/bin/agent-seed
if ! as_agent tmux has-session -t =agent 2>/dev/null; then
  first=$(head -n1 /run/agent/sessions)
  as_agent tmux new-session -d -s agent -n "$first" -x 200 -y 50 "/usr/local/bin/agent-harness $first"
  as_agent tmux set-option -g history-limit 50000
  as_agent tmux set-option -g focus-events on
  as_agent tmux set-option -g window-size largest
  tail -n +2 /run/agent/sessions | while read -r s; do
    as_agent tmux new-window -d -t =agent: -n "$s" "/usr/local/bin/agent-harness $s"
  done
fi
/usr/local/bin/agent-health --repair >/dev/null
echo ok
