#!/bin/bash
window="$1"
set -a
. /run/agent/env
set +a
export AGENT_WINDOW="$window" HOME=/home/agent XDG_RUNTIME_DIR=/run/agent/xdg CLAUDE_CODE_TMPDIR=/run/agent/xdg
export DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
prompt=$(cat /run/agent/system-prompt.txt)
session_file="$HOME/.agent-host/sessions/$window"
cd /agent
while :; do
  session=$(cat "$session_file" 2>/dev/null || true)
  started=$SECONDS
  if [ -n "$session" ]; then
    claude --dangerously-skip-permissions --append-system-prompt "$prompt" --resume "$session"
    if [ $((SECONDS - started)) -lt 10 ]; then rm -f "$session_file"; fi
  else
    claude --dangerously-skip-permissions --append-system-prompt "$prompt"
  fi
  sleep 2
done
